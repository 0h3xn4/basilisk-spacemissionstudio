#!/bin/sh
# postinst: runs automatically after dpkg unpacks this package's files.
# Creates SpaceMissionStudio's own dedicated virtualenv under /opt/spacemissionstudio,
# installs Basilisk (from PyPI -- needs internet access, the one thing this
# package genuinely cannot bundle: see packaging/README.md's "The vendoring
# decision") and SpaceMissionStudio itself (from the wheel this package DOES
# bundle, at /opt/spacemissionstudio/dist -- no network needed for that part),
# then wires up a /usr/bin/spacemissionstudio launcher and renders the app icon.
#
# Standard Debian maintainer-script convention: `set -e` so any failure
# here aborts cleanly (dpkg reports the package as not fully configured,
# rather than silently leaving a half-working install) and re-running
# `apt install --reinstall spacemissionstudio` (or `dpkg-reconfigure`, if this
# is ever registered as one) retries from a clean slate.

set -e

INSTALL_DIR=/opt/spacemissionstudio
VENV_DIR="$INSTALL_DIR/venv"
ICON_DIR=/usr/share/icons/hicolor/256x256/apps
LAUNCHER=/usr/bin/spacemissionstudio

case "$1" in
    configure)
        # A previous install/upgrade may have left a venv behind (e.g. an
        # interrupted or failed prior run) -- always start from a clean
        # slate rather than layering a new install on top of a possibly
        # -broken one.
        if [ -d "$VENV_DIR" ]; then
            rm -rf "$VENV_DIR"
        fi

        echo "SpaceMissionStudio: creating its Python environment at $VENV_DIR ..."
        python3 -m venv "$VENV_DIR"
        "$VENV_DIR/bin/python3" -m pip install --quiet --upgrade pip

        echo "SpaceMissionStudio: installing Basilisk 2.12.0 (bsk[all]==2.12.0, the version SpaceMissionStudio is qualified with) from PyPI -- this needs internet access and can take a few minutes ..."
        "$VENV_DIR/bin/python3" -m pip install --quiet "bsk[all]==2.12.0"

        wheel=$(ls "$INSTALL_DIR"/dist/spacemissionstudio-*.whl 2>/dev/null | head -n1)
        if [ -z "$wheel" ]; then
            echo "SpaceMissionStudio postinst: no bundled wheel found under $INSTALL_DIR/dist -- this package is broken." >&2
            exit 1
        fi
        echo "SpaceMissionStudio: installing SpaceMissionStudio itself from the bundled wheel ..."
        "$VENV_DIR/bin/python3" -m pip install --quiet "${wheel}[gui]"

        # SpaceMissionStudio never accesses the network at runtime (real
        # user requirement: "the app must be completely closed off and
        # offline, only exception is the installation process") -- this
        # is that one exception. engine.kernels.require_kernels()'s own
        # default (ALL_SUPPORT_DATA_FILES) covers every SPICE/gravity
        # -harmonics/magnetic-field support-data file any of this app's
        # code paths read, fetching each one once into Basilisk's own
        # local pooch cache; every later get_path() call for the rest of
        # this install's lifetime resolves from that cache with no
        # network touched at all. FATAL here (unlike packaging/install.sh,
        # where a Basilisk wheel is itself optional): this postinst
        # always installs a real Basilisk, so a scenario that can never
        # actually run without its own kernels is exactly the kind of
        # "configured but broken" state `set -e` exists to refuse. Run
        # only now (not right after Basilisk, above): it imports
        # spacemissionstudio itself, which isn't installed into this venv
        # until the pip install just above completes.
        echo "SpaceMissionStudio: pre-fetching SPICE kernels and other support data -- this needs internet access ..."
        "$VENV_DIR/bin/python3" -c "
from spacemissionstudio.engine import kernels
kernels.require_kernels()
"

        cat > "$LAUNCHER" <<EOF
#!/bin/sh
exec "$VENV_DIR/bin/spacemissionstudio" "\$@"
EOF
        chmod 755 "$LAUNCHER"

        # Renders gui/icons.py's procedurally-drawn app icon (QPainter, no
        # bitmap asset shipped in the repo -- see that module's docstring)
        # into the standard XDG hicolor icon theme location, using the
        # 'offscreen' Qt platform plugin so no display is needed. Needs
        # PySide6 (just installed above via the [gui] extra). Non-fatal:
        # a failure here still leaves a fully working install, just with
        # the desktop entry's Icon=spacemissionstudio falling back to a
        # generic icon.
        mkdir -p "$ICON_DIR"
        if QT_QPA_PLATFORM=offscreen "$VENV_DIR/bin/python3" -c "
from spacemissionstudio.gui.icons import ensure_icon_file
ensure_icon_file('$ICON_DIR/spacemissionstudio.png')
" 2>/dev/null; then
            :
        else
            echo "SpaceMissionStudio: could not render the app icon (non-fatal) -- the menu entry will use a generic icon." >&2
        fi

        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q /usr/share/icons/hicolor >/dev/null 2>&1 || true
        fi

        echo ""
        echo "SpaceMissionStudio installed. Find it in your application menu, or run: spacemissionstudio gui"
        ;;
esac

exit 0
