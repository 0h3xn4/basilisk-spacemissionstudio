% SpaceMissionStudio validation V-05 (ContactLocator): point-mass Earth
Create Spacecraft sat;
sat.DateFormat = UTCGregorian;
sat.Epoch = '01 Jun 2024 00:00:00.000';
sat.CoordinateSystem = EarthMJ2000Eq;
sat.DisplayStateType = Cartesian;
sat.X = 6778.137;
sat.Y = 0.0;
sat.Z = 0.0;
sat.VX = 0.0;
sat.VY = 4.668322;
sat.VZ = 6.083876;
sat.DryMass = 500.0;
sat.Cr = 1.3;
sat.Cd = 2.2;
sat.SRPArea = 10.0;
sat.DragArea = 10.0;
Earth.Mu = 398600.436;
Sun.Mu = 132712440023.31;
Luna.Mu = 4902.799;
Earth.EquatorialRadius = 6378.137;
Earth.Flattening = 0.0033528106647474805;
SolarSystem.EphemerisSource = 'SPICE';
SolarSystem.SPKFilename = '/root/.cache/bsk_support_data/supportData/EphemerisData/de430.bsp';
Create ForceModel fm;
fm.CentralBody = Earth;
fm.PrimaryBodies = {Earth};
fm.GravityField.Earth.PotentialFile = '/home/user/basilisk/SpaceMissionStudio/compliance/validation/gmat/GGM03S_20.grv';
fm.GravityField.Earth.Degree = 0;
fm.GravityField.Earth.Order = 0;
Create Propagator prop;
prop.FM = fm;
prop.Type = PrinceDormand78;
prop.InitialStepSize = 10;
prop.Accuracy = 1e-13;
prop.MinStep = 0;
prop.MaxStep = 60;
Create GroundStation berlin;
berlin.CentralBody = Earth;
berlin.StateType = Spherical;
berlin.HorizonReference = Ellipsoid;
berlin.Location1 = 52.52;
berlin.Location2 = 13.405;
berlin.Location3 = 0.034;
berlin.MinimumElevationAngle = 10.0;
Create ContactLocator cl;
cl.Target = sat;
cl.Observers = {berlin};
cl.Filename = 'contacts_berlin.txt';
cl.UseLightTimeDelay = false;
cl.UseStellarAberration = false;
cl.StepSize = 10;
cl.RunMode = 'Automatic';
cl.UseEntireInterval = true;
BeginMissionSequence;
Propagate prop(sat) {sat.ElapsedDays = 1.0};
