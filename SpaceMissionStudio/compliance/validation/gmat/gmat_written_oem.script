prop.InitialStepSize = 10;
prop.Accuracy = 1e-13;
prop.MinStep = 0;
prop.MaxStep = 60;
Create EphemerisFile eph;
eph.Spacecraft = sat;
eph.Filename = 'gmat_written.oem';
eph.FileFormat = CCSDS-OEM;
eph.EpochFormat = UTCGregorian;
eph.CoordinateSystem = EarthMJ2000Eq;
eph.Interpolator = Lagrange;
eph.InterpolationOrder = 7;
eph.StepSize = 60;
BeginMissionSequence;
Propagate prop(sat) {sat.ElapsedSecs = 7200.0};
