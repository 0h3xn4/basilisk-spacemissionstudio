% SpaceMissionStudio validation case third_body_geo: Sun and Moon point masses, DE430
Create Spacecraft sat;
sat.DateFormat = UTCGregorian;
sat.Epoch = '15 Mar 2024 00:00:00.000';
sat.CoordinateSystem = EarthMJ2000Eq;
sat.DisplayStateType = Cartesian;
sat.X = 42164.17;
sat.Y = 0.0;
sat.Z = 0.0;
sat.VX = 0.0;
sat.VY = 3.07466;
sat.VZ = 0.0537;
sat.DryMass = 500.0;
sat.Cr = 1.3;
sat.Cd = 2.2;
sat.SRPArea = 10.0;
sat.DragArea = 10.0;
Earth.Mu = 398600.436;
Sun.Mu = 132712440023.31;
Luna.Mu = 4902.799;
Earth.EquatorialRadius = 6378.137;
Earth.Flattening = 0.0033528106647474805;
SolarSystem.EphemerisSource = 'SPICE';
SolarSystem.SPKFilename = '/root/.cache/bsk_support_data/supportData/EphemerisData/de430.bsp';
Create ForceModel fm;
fm.CentralBody = Earth;
fm.PrimaryBodies = {Earth};
fm.GravityField.Earth.PotentialFile = '/home/user/basilisk/SpaceMissionStudio/compliance/validation/gmat/GGM03S_20.grv';
fm.GravityField.Earth.Degree = 0;
fm.GravityField.Earth.Order = 0;
fm.PointMasses = {Sun, Luna};
Create Propagator prop;
prop.FM = fm;
prop.Type = PrinceDormand78;
prop.InitialStepSize = 10;
prop.Accuracy = 1e-13;
prop.MinStep = 0;
prop.MaxStep = 60;
Create ReportFile rep;
rep.Filename = 'third_body_geo.txt';
rep.Precision = 16;
rep.WriteHeaders = false;
Create Variable k;
BeginMissionSequence;
For k = 0:1008
  Report rep sat.UTCModJulian sat.X sat.Y sat.Z sat.VX sat.VY sat.VZ;
  Propagate prop(sat) {sat.ElapsedSecs = 600.0};
EndFor;
